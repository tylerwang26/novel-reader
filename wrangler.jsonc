{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novel-reader",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PROGRESS",
      "id": "44495cda6a8b4f49a89a3bb7e31ad5cf"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
